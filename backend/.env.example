# RetailIQ Backend Environment Configuration
APP_NAME=RetailIQ API
APP_ENV=development
DEBUG=True

# Relative Paths (Default to project root)
DATABASE_PATH=../retailiq.db
MODEL_PATH=../models/trained/retailiq_forecaster.pkl
POLICY_DOC_PATH=../data/knowledge_base/policy_docs.txt

# AI Assistant Configuration
# Options for AI_PROVIDER: anthropic, openai, or leave empty for deterministic rule-based engine
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
